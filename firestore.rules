rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }
    match /regions/{id} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /towns/{id} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /categories/{id} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /specialties/{id} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /providers/{id} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /publicStats/{id} {
      allow read: if id == 'main';
      allow create: if id == 'main'
        && request.resource.data.keys().hasOnly(['visits', 'updatedAt'])
        && request.resource.data.visits == 1
        && request.resource.data.updatedAt == request.time;
      allow update: if id == 'main'
        && request.resource.data.keys().hasOnly(['visits', 'updatedAt'])
        && request.resource.data.visits == resource.data.visits + 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /providerRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','regionId','townId','categoryId','specialtyIds','phone','whatsapp','address','description','status','source','createdAt'])
        && request.resource.data.keys().hasAll(['name','regionId','townId','categoryId','specialtyIds','phone','address','status','source','createdAt'])
        && request.resource.data.status == 'pending' && request.resource.data.source == 'website'
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 5 && request.resource.data.phone.size() <= 30
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 30
        && request.resource.data.address is string && request.resource.data.address.size() >= 3 && request.resource.data.address.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && request.resource.data.specialtyIds is list && request.resource.data.specialtyIds.size() == 1;
      allow read, update, delete: if isAdmin();
    }
    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /reports/{id} {
      allow create: if request.resource.data.keys().hasOnly(['reporterName','contact','type','details','pageUrl','status','createdAt'])
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && request.resource.data.reporterName is string && request.resource.data.reporterName.size() <= 100
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 150
        && request.resource.data.type in ['incorrect','closed','abuse','privacy','other']
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 1200
        && request.resource.data.pageUrl is string && request.resource.data.pageUrl.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
